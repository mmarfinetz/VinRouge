{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r dexy/requirements.txt"
  },
  "deploy": {
    "startCommand": "cd dexy && gunicorn server:app --log-file -",
    "healthcheckPath": "/status",
    "healthcheckTimeout": 90,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
